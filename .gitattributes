# Satır sonlarını normalize et
* text=auto

# Windows kaynak dosyaları CRLF
*.cs       text eol=crlf diff=csharp
*.ps1      text eol=crlf
*.manifest text eol=crlf
*.md       text eol=lf
*.yml      text eol=lf
*.json     text eol=lf

# İkili dosyalar
*.ico binary
*.png binary
*.exe binary
*.dll binary
