root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4
end_of_line = crlf

[*.{ps1,manifest}]
indent_style = space
indent_size = 4
end_of_line = crlf

[*.{md,yml,yaml,json}]
indent_style = space
indent_size = 2
end_of_line = lf
